<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Eve – Karyawan Digital Rumah Sakit</title>
<style>
:root{--bg:#f6f9fc;--card:#fff;--text:#1e293b;--muted:#64748b;--primary:#0f766e;--primary2:#14b8a6;--soft:#e6f6f4;--danger:#dc2626;--dsoft:#fef2f2;--line:#e2e8f0}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',system-ui,Arial,sans-serif;background:var(--bg);color:var(--text);line-height:1.6}
section{max-width:1040px;margin:0 auto;padding:56px 20px}
h2{font-size:1.7rem;text-align:center;margin-bottom:8px}
.sub{text-align:center;color:var(--muted);margin-bottom:32px}
.hero{text-align:center;padding-top:72px}
.avatar{width:96px;height:96px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary2));color:#fff;font-size:2.8rem;font-weight:700;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;box-shadow:0 10px 30px rgba(15,118,110,.3)}
.hero h1{font-size:2.6rem;margin-bottom:10px}
.badge{display:inline-block;background:var(--soft);color:var(--primary);border:1px solid #99e0d6;padding:6px 16px;border-radius:999px;font-weight:600;font-size:.9rem;margin-bottom:18px;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(20,184,166,.4)}50%{box-shadow:0 0 0 8px rgba(20,184,166,0)}}
.tagline{max-width:600px;margin:0 auto;font-size:1.15rem;color:var(--muted)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.box{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:26px;box-shadow:0 2px 10px rgba(15,23,42,.05)}
.chaos{background:var(--dsoft);border-color:#fecaca}
.chaos h3{color:var(--danger)}
.sol{background:var(--soft);border-color:#99e0d6}
.sol h3{color:var(--primary)}
.box h3{margin-bottom:14px}
.box ul{list-style:none}
.box li{padding:8px 0 8px 28px;position:relative;font-size:.97rem}
.chaos li::before{content:"✖";position:absolute;left:0;color:var(--danger)}
.sol li::before{content:"✔";position:absolute;left:0;color:var(--primary)}
.cap .ic{font-size:2rem;margin-bottom:10px}
.cap h3{margin-bottom:6px}
.cap p{color:var(--muted);font-size:.95rem}
.chat{max-width:680px;margin:0 auto;background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 8px 30px rgba(15,23,42,.08)}
.chat-head{background:linear-gradient(135deg,var(--primary),var(--primary2));color:#fff;padding:14px 20px;font-weight:600}
.chat-body{height:340px;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:12px;background:#fafcfd}
.msg{max-width:82%;padding:10px 14px;border-radius:14px;font-size:.94rem;animation:fade .3s}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.user{align-self:flex-end;background:var(--primary);color:#fff;border-bottom-right-radius:4px}
.bot{align-self:flex-start;background:#fff;border:1px solid var(--line);border-bottom-left-radius:4px}
.typing span{display:inline-block;width:7px;height:7px;margin:0 2px;border-radius:50%;background:#94a3b8;animation:bounce 1s infinite}
.typing span:nth-child(2){animation-delay:.15s}.typing span:nth-child(3){animation-delay:.3s}
@keyframes bounce{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-6px)}}
.placeholder{color:var(--muted);text-align:center;margin:auto;font-size:.92rem}
.btns{display:flex;gap:10px;flex-wrap:wrap;padding:14px 18px;border-top:1px solid var(--line);background:#fff}
.btns button{flex:1;min-width:150px;padding:10px 12px;border:1.5px solid var(--primary);background:#fff;color:var(--primary);border-radius:10px;font-weight:600;cursor:pointer;font-size:.88rem;transition:.2s}
.btns button:hover:not(:disabled){background:var(--primary);color:#fff}
.btns button:disabled{opacity:.5;cursor:not-allowed}
footer{background:#0f172a;color:#cbd5e1;text-align:center;padding:56px 20px}
footer h2{color:#fff;margin-bottom:10px}
.cta{display:inline-block;margin:18px 0 28px;background:linear-gradient(135deg,var(--primary),var(--primary2));color:#fff;text-decoration:none;font-weight:700;font-size:1.1rem;padding:16px 36px;border-radius:999px;box-shadow:0 10px 25px rgba(20,184,166,.4);transition:.2s}
.cta:hover{transform:translateY(-3px)}
footer small{display:block;color:#94a3b8}
@media(max-width:760px){.grid2,.grid3{grid-template-columns:1fr}.hero h1{font-size:2.1rem}section{padding:40px 16px}}
</style>
</head>
<body>

<section class="hero">
  <div class="avatar">E</div>
  <h1>Eve</h1>
  <div class="badge">🟢 Status: Active &amp; Ready 24/7</div>
  <p class="tagline">Karyawan digital yang membantu meningkatkan produktivitas pekerja kantoran di rumah sakit.</p>
</section>

<section>
  <h2>Dari Kekacauan Menuju Keteraturan</h2>
  <p class="sub">Masalah harian yang diselesaikan oleh Eve</p>
  <div class="grid2">
    <div class="box chaos">
      <h3>😵 The Chaos</h3>
      <ul>
        <li>Sering belum merencanakan apa yang akan dikerjakan hari ini.</li>
        <li>Belum ada asisten yang mengingatkan pekerjaan.</li>
        <li>Belum ada asisten yang merangkum dan menyusun jadwal kerja terstruktur, sehingga pekerjaan kurang efektif dan efisien.</li>
      </ul>
    </div>
    <div class="box sol">
      <h3>✨ The Solution</h3>
      <ul>
        <li>Eve membantu merencanakan prioritas pekerjaan setiap hari.</li>
        <li>Eve membuat jadwal yang terhubung langsung dengan Google Calendar.</li>
        <li>Eve mengingatkan tugas dan memberikan evaluasi harian.</li>
        <li>Semua eksekusi hanya dilakukan atas seizin Anda (Human-in-the-Loop).</li>
      </ul>
    </div>
  </div>
</section>

<section>
  <h2>Kemampuan Utama</h2>
  <p class="sub">Tiga tools yang bekerja bersama Eve</p>
  <div class="grid3">
    <div class="box cap"><div class="ic">📅</div><h3>Google Calendar</h3><p>Menyusun dan menyinkronkan jadwal kerja terstruktur secara otomatis.</p></div>
    <div class="box cap"><div class="ic">📁</div><h3>Google Drive &amp; WhatsApp</h3><p>Mengakses dokumen kerja dan mengirim pengingat langsung ke WhatsApp Anda.</p></div>
    <div class="box cap"><div class="ic">🛡️</div><h3>Human-in-the-Loop</h3><p>Setiap keputusan eksekusi wajib menunggu persetujuan Anda terlebih dahulu.</p></div>
  </div>
</section>

<section>
  <h2>Coba Simulasi Eve</h2>
  <p class="sub">Pilih salah satu skenario di bawah ini</p>
  <div class="chat">
    <div class="chat-head">💬 Eve · Asisten Produktivitas</div>
    <div class="chat-body" id="chat"><p class="placeholder" id="ph">Klik salah satu tombol skenario untuk memulai percakapan.</p></div>
    <div class="btns">
      <button data-i="0">📋 Rencanakan hari ini</button>
      <button data-i="1">⏰ Pengingat rapat</button>
      <button data-i="2">📊 Evaluasi harian</button>
    </div>
  </div>
</section>

<footer>
  <h2>Siap Bekerja Lebih Efektif bersama Eve?</h2>
  <p>Hubungi kami dan mulai atur hari kerja Anda dengan lebih terstruktur.</p>
  <a class="cta" href="https://wa.me/628194140580" target="_blank" rel="noopener">💬 Hubungi via WhatsApp</a>
  <small>Built with AI · AI Builder Bootcamp Showcase</small>
</footer>

<script>
const scenarios=[
 {u:"Eve, tolong rencanakan pekerjaan saya hari ini.",
  b:"Selamat pagi, Dok! Berikut usulan jadwal hari ini:<br>• 08.00 Review laporan layanan medis<br>• 10.00 Rapat koordinasi penunjang medis<br>• 13.00 Verifikasi dokumen kerja sama<br>• 15.00 Tindak lanjut email<br><br>Apakah saya boleh menambahkannya ke Google Calendar? <b>(Menunggu persetujuan Anda)</b>"},
 {u:"Ingatkan saya untuk rapat koordinasi besok pukul 10.00.",
  b:"Baik! Saya siapkan pengingat WhatsApp untuk besok pukul 09.30 beserta ringkasan agenda dari Google Drive. Kirim pengingat sekarang? <b>(Menunggu persetujuan Anda)</b>"},
 {u:"Eve, bagaimana evaluasi pekerjaan saya hari ini?",
  b:"Evaluasi harian: 4 dari 5 tugas selesai (80%) ✅<br>Tertunda: verifikasi dokumen kerja sama.<br>Saran: jadwalkan ulang besok pukul 09.00. Setujui perubahan jadwal? <b>(Menunggu persetujuan Anda)</b>"}
];
const chat=document.getElementById('chat'),btns=document.querySelectorAll('.btns button');
function add(cls,html){const d=document.createElement('div');d.className='msg '+cls;d.innerHTML=html;chat.appendChild(d);chat.scrollTop=chat.scrollHeight;return d}
const wait=ms=>new Promise(r=>setTimeout(r,ms));
btns.forEach(b=>b.addEventListener('click',async()=>{
  const s=scenarios[b.dataset.i];
  btns.forEach(x=>x.disabled=true);
  chat.innerHTML='';
  add('user',s.u);
  await wait(500);
  const t=add('bot typing','<span></span><span></span><span></span>');
  await wait(1600);
  t.remove();
  add('bot',s.b);
  btns.forEach(x=>x.disabled=false);
}));
</script>
</body>
</html>
